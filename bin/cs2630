#!/usr/bin/env bash
# Unified helper for the CS2630 remote-access setup: SSH, VS Code Remote-SSH,
# VM power control, and shortcuts to the repo's setup/verify scripts.
# Installed as a symlink at ~/.local/bin/cs2630 by install-host.sh and
# install-client.sh — works the same whether run on the actual VirtualBox
# host or a remote client, hopping over SSH automatically where needed.

set -euo pipefail

info()  { printf '\e[1;34m[INFO]\e[0m  %s\n' "$*"; }
warn()  { printf '\e[1;33m[WARN]\e[0m  %s\n' "$*"; }
ok()    { printf '\e[1;32m[ OK ]\e[0m  %s\n' "$*"; }

# Resolve symlinks without relying on GNU-only `readlink -f`, which isn't
# guaranteed on macOS/BSD readlink — this loop works with either.
resolve_symlink() {
    local target="$1" link
    while [[ -L "$target" ]]; do
        link="$(readlink "$target")"
        case "$link" in
            /*) target="$link" ;;
            *)  target="$(dirname "$target")/$link" ;;
        esac
    done
    printf '%s\n' "$target"
}

REPO_DIR="$(cd "$(dirname "$(resolve_symlink "${BASH_SOURCE[0]}")")/.." && pwd)"
VM_USER="${VM_USER:-student}"
VM_REMOTE_HOME="${VM_REMOTE_HOME:-/home/$VM_USER}"

usage() {
    cat <<'EOF'
Usage: cs2630 <command> [args]

  sh                    SSH into the CS2630 VM                 (ssh cs2630)
  code <path>           Open <path> on the VM in VS Code       (Remote-SSH)
  poweron               Start the VM (hops to the host if needed)
  poweroff              Gracefully stop the VM (ACPI shutdown)
  install host          Run install-host.sh
  install client        Run install-client.sh
  install aws           Run install-aws.sh
  verify                Run scripts/verify.sh
  autostart             Run scripts/configure-vm-autostart.sh
EOF
}

# True when run directly on the VirtualBox host (VBoxManage present locally).
on_host() { command -v VBoxManage &>/dev/null; }

# Run a shell command on the VirtualBox host: locally if we're already there,
# otherwise over the cs2630-host SSH alias.
run_on_host() {
    if on_host; then
        bash -c "$1"
    else
        ssh cs2630-host "$1"
    fi
}

vm_running() {
    [[ -n "$(run_on_host 'VBoxManage list runningvms' 2>/dev/null)" ]]
}

cmd="${1:-}"
shift || true

case "$cmd" in
    sh)
        exec ssh cs2630
        ;;
    code)
        [[ $# -ge 1 ]] || { echo "Usage: cs2630 code <path>" >&2; exit 1; }
        target="$1"
        [[ "$target" = /* ]] || target="$VM_REMOTE_HOME/$target"
        exec code --remote "ssh-remote+cs2630" "$target"
        ;;
    poweron)
        if vm_running; then
            ok "VM is already running."
        else
            info "Starting the VM..."
            run_on_host 'name="$(cat "$HOME/.config/cs2630/vm-name" 2>/dev/null)"; [ -n "$name" ] || { echo "No VM configured. Run: cs2630 autostart" >&2; exit 1; }; VBoxManage startvm "$name" --type headless'
            ok "VM started. It may take a bit before SSH is reachable."
        fi
        ;;
    poweroff)
        if ! vm_running; then
            ok "VM is already off."
            exit 0
        fi
        info "Sending ACPI shutdown signal..."
        run_on_host 'name="$(cat "$HOME/.config/cs2630/vm-name" 2>/dev/null)"; [ -n "$name" ] || { echo "No VM configured. Run: cs2630 autostart" >&2; exit 1; }; VBoxManage controlvm "$name" acpipowerbutton'
        info "Waiting for the guest to shut down (up to 2 minutes)..."
        for _ in $(seq 1 60); do
            vm_running || { ok "VM is powered off."; exit 0; }
            sleep 2
        done
        warn "VM is still running after 2 minutes."
        warn "The guest OS may not be handling the ACPI power signal (check acpid/logind in the guest)."
        vm_name="$(run_on_host 'VBoxManage list runningvms' 2>/dev/null | sed -n 's/^"\(.*\)" {.*}/\1/p' | head -1)"
        warn "To force it off, run on the host: VBoxManage controlvm \"${vm_name:-<name>}\" poweroff"
        exit 1
        ;;
    install)
        sub="${1:-}"
        case "$sub" in
            host)   exec "$REPO_DIR/install-host.sh" ;;
            client) exec "$REPO_DIR/install-client.sh" ;;
            aws)    exec "$REPO_DIR/install-aws.sh" ;;
            *)
                echo "Usage: cs2630 install <host|client|aws>" >&2
                exit 1
                ;;
        esac
        ;;
    verify)
        exec "$REPO_DIR/scripts/verify.sh"
        ;;
    autostart)
        exec "$REPO_DIR/scripts/configure-vm-autostart.sh"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
